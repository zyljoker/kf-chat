{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-sdk/types",
    "rootDir": "src",
    "allowImportingTsExtensions": false
  },
  "include": ["src/sdk.ts", "src/types.ts", "src/components/**/*.vue"],
  "exclude": ["dist", "dist-sdk", "node_modules"]
}
