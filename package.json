{
  "name": "yun-kefu-widget",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Embeddable cloud customer service widget built with Vue 3, Element Plus and Element Plus X",
  "main": "./dist-sdk/customer-service-sdk.es.js",
  "module": "./dist-sdk/customer-service-sdk.es.js",
  "types": "./dist-sdk/types/sdk.d.ts",
  "style": "./dist-sdk/customer-service-sdk.css",
  "exports": {
    ".": {
      "types": "./dist-sdk/types/sdk.d.ts",
      "import": "./dist-sdk/customer-service-sdk.es.js",
      "default": "./dist-sdk/customer-service-sdk.es.js"
    },
    "./style.css": "./dist-sdk/customer-service-sdk.css"
  },
  "files": [
    "dist-sdk",
    "EMBED.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:demo": "vite build",
    "build:sdk": "vite build --mode sdk && vue-tsc -p tsconfig.sdk.json",
    "build": "npm run typecheck && npm run build:demo && npm run build:sdk",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.7",
    "three": "^0.187.0",
    "vue": "^3.5.17",
    "vue-element-plus-x": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vue-tsc": "^2.2.10"
  }
}
